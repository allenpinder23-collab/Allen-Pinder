# Prisma connection string. Defaults to a local SQLite file for dev.
# For production, point this at a managed Postgres instance and change
# `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Required: 32-byte hex key used for AES-256-GCM encryption of stored plan
# data. Generate your own with: openssl rand -hex 32
# Losing this key makes all previously stored plans permanently unreadable.
ENCRYPTION_KEY=

# Required: Anthropic API key used to generate client plans.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for analysis.
# Defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL=claude-sonnet-5

# Used once by `npm run db:seed` to create (or update) the first admin
# account. Not read at runtime after that.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
